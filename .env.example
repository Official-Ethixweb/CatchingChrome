# Live river conditions for the fishing calendar's "today" outlook.
# Get a free key at https://openweathermap.org/api (Current Weather Data).
# Copy this file to `.env` and paste your key below.
OPENWEATHER_API_KEY=

# Live Google reviews for the Client Log carousel.
# Needs "Places API (New)" enabled on a billing-enabled Google Cloud project:
# https://console.cloud.google.com/apis/library/places.googleapis.com
# Without it the Client Log falls back to the curated reviews in
# src/lib/googleReviews.ts.
GOOGLE_PLACES_API_KEY=

# Contact form delivery via SMTP2GO. REQUIRED for the form to actually reach
# Ryan — without the key + to-address the form cannot send, and tells the guest
# to call or email instead (it never claims to have sent).
# 1. Create a key at SMTP2GO → Settings → API Keys (starts with "api-...").
# 2. CONTACT_TO_EMAIL is the inbox enquiries land in.
# 3. CONTACT_FROM_EMAIL must be an address on the SMTP2GO-verified sender
#    domain (catchingchromeguideservice.com). If unset it defaults to
#    noreply@catchingchromeguideservice.com.
# 4. CONTACT_BCC_EMAILS is an optional comma-separated list of silent copies
#    (the agency inboxes). Leave blank to send to CONTACT_TO_EMAIL only.
SMTP2GO_API_KEY=
CONTACT_TO_EMAIL=ryanbfishin@gmail.com
CONTACT_FROM_EMAIL=noreply@catchingchromeguideservice.com
CONTACT_BCC_EMAILS=amar@ethixweb.com,akash@ethixweb.com

# Contact-form bot protection — Google reCAPTCHA v2 ("I'm not a robot" checkbox).
# Create keys at https://www.google.com/recaptcha/admin/create
#   • Type: reCAPTCHA v2 → "I'm not a robot" Checkbox
#   • Domains: catchingchromeguideservice.com  AND  localhost (for testing)
# The SITE key is public (ships to the browser, hence the VITE_ prefix); the
# SECRET key stays server-side. The checkbox only shows when the SITE key is
# set, and the server only enforces it when the SECRET key is set — so set BOTH
# to turn protection on. Leave both blank to keep the form open (no captcha).
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Google Tag Manager. The container is the umbrella; GA4 (and any other tags)
# are configured INSIDE GTM, so no code change is needed to add or edit them.
# Create a container at https://tagmanager.google.com (Web), copy its id
# (format GTM-XXXXXXX), and set it here AND in the Vercel production env, then
# rebuild/redeploy (it is a build-time value). Blank = analytics fully off; the
# site ships without loading GTM at all.
#
# SPA note: this is a client-routed app, so route changes don't reload the page.
# The site pushes a custom `page_view` event to the dataLayer on every route
# change (page_path, page_location, page_title). To avoid double-counting the
# first view, in GTM set the GA4 Configuration tag's send_page_view = false and
# add a GA4 Event tag (event name: page_view) fired by a Custom Event trigger on
# `page_view`, mapping page_location / page_path / page_title from dataLayer
# variables.
#
# Conversion events already pushed to the dataLayer (build GA4 conversions on
# these in GTM via Custom Event triggers):
#   • contact_form_submit — fires only on a confirmed send (params: trip_type,
#     group_size). This is the main lead conversion.
#   • phone_click        — any tel: link tapped (params: link_url, link_text).
#   • email_click        — any mailto: link tapped (params: link_url, link_text).
# Note: phone_click measures intent to call, not a connected call. True
# call-connect tracking needs a call-tracking number (e.g. CallRail) — separate.
VITE_GTM_ID=

# Google Ads conversion tracking (separate from GTM/GA4 above). Get both values
# from the Google Ads conversion action's snippet (Tools > Conversions > your
# action > "Use Google tag directly on your website"): VITE_GOOGLE_ADS_ID is
# the AW-XXXXXXXXX send-to id, VITE_GOOGLE_ADS_CONTACT_LABEL is the label after
# the slash. Both public, client-side values — set BOTH in this project's own
# Vercel env to turn Ads conversion tracking on; leave either blank and no Ads
# tag loads at all (same fail-safe shape as VITE_GTM_ID). Blank in local dev on
# purpose, so a developer's testing never reports a conversion into the live
# campaign. Before going live, confirm this id belongs to Catching Chrome's own
# Google Ads account, not a value copied from another project.
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_CONTACT_LABEL=
